10 REM PK8000 SURA - THE SCREEN MODES (SCREEN 3 IS BORDER ONLY ON THIS MACHINE)
20 SCREEN 0:COLOR 15,4,4:PRINT "PK8000 SURA GRAPHICS DEMO":PRINT:PRINT "SCREEN 0 - TEXT, 40 COLUMNS"
30 FOR I=1 TO 300:NEXT
40 SCREEN 1:COLOR 10,1,1:PRINT "SCREEN 1 - TEXT, 32 COLUMNS":PRINT:FOR I=1 TO 8:PRINT "THE QUICK BROWN FOX JUMPS OVER":NEXT
50 FOR I=1 TO 300:NEXT
60 SCREEN 2:COLOR 15,1,1
70 FOR C=1 TO 15:LINE (C*16,0)-(C*16+15,95),C,BF:NEXT
80 FOR C=1 TO 15:LINE (128,96)-(255,191),C:NEXT
90 LINE (0,96)-(127,191),9,BF:LINE (0,96)-(127,191),15:LINE (0,191)-(127,96),15
100 FOR I=1 TO 300:NEXT
110 SCREEN 2:COLOR 15,1,1
120 FOR C=1 TO 15:LINE (C*8,C*6)-(255-C*8,191-C*6),C,BF:NEXT
130 FOR Y=0 TO 191 STEP 8:FOR X=0 TO 255 STEP 8:PSET (X,Y),15:NEXT:NEXT
140 FOR I=1 TO 300:NEXT
150 GOTO 20
